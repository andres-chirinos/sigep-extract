# Configuración del Extractor SIGEP
OUTPUT_FILE=/app/data/sigep_export.jsonl
DELAY_BETWEEN_PAGES=1800
RESOLUTION=1600x1000x24

# Configuración S3 (AWS S3, Cloudflare R2, MinIO, Wasabi, etc.)
# Si se deja S3_BUCKET vacío, el extractor solo guardará en el disco local (/app/data).
S3_BUCKET=mi-bucket-sigep
S3_REGION=auto
# Dejar S3_ENDPOINT vacío si usas AWS S3 oficial.
# Para Cloudflare R2: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# Para MinIO: http://minio-ip:9000
S3_ENDPOINT=
S3_ACCESS_KEY_ID=tu_access_key
S3_SECRET_ACCESS_KEY=tu_secret_key
S3_KEY_PREFIX=sigep/
# Sincronizar archivo y status.json cada N registros extraídos:
S3_SYNC_INTERVAL=500
# Activar true para MinIO:
S3_FORCE_PATH_STYLE=false
