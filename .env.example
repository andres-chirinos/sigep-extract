# Modo de operación:
# 'client'  -> Navegador interactivo general con noVNC, consola DevTools libre, lanzador de scripts y archivado WARC.
# 'scraper' -> Extractor autónomo en segundo plano para SIGEP con auto-reanudación.
APP_MODE=client

# URL de inicio para el navegador
START_URL=https://sigep.gob.bo/rsportaltransparencia/#/portalHome/personal

# Grabación de Archivo Web (WARC 1.1)
WARC_ENABLED=true
WARC_OUTPUT_DIR=/app/data/archives
WARC_SYNC_INTERVAL_MINUTES=10

# Script para auto-ejecutar en consola al iniciar (opcional, ej: extractor.js)
AUTO_EXECUTE_SCRIPT=

# Configuración del Extractor (usado si APP_MODE=scraper)
OUTPUT_FILE=/app/data/sigep_export.jsonl
DELAY_BETWEEN_PAGES=1800
RESOLUTION=1600x1000x24

# Configuración S3 (AWS S3, Cloudflare R2, MinIO, Wasabi, etc.)
# Si se define, sincroniza automáticamente archivos .warc.gz, sigep_export.jsonl y status.json
S3_BUCKET=
S3_REGION=auto
# Dejar vacío si es AWS oficial. Especificar para Cloudflare R2 o MinIO:
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_KEY_PREFIX=sigep/
S3_SYNC_INTERVAL=500
S3_FORCE_PATH_STYLE=false
